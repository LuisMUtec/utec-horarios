# Credenciales del proyecto de Supabase. Ambas son públicas por diseño: viajan
# al navegador. Cópialas desde el dashboard (Project Settings → API Keys).
# Sin ellas la app funciona igual, solo queda deshabilitado el login.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Analítica de producto (PostHog). Opcional: sin ellas la app funciona igual y
# no se mide nada. El token es público por diseño: viaja al navegador. El host
# es el de la nube donde vive el proyecto (us o eu).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Origen público con el que se arman las URLs de redirección del login.
# Opcional: en Vercel se deduce del deploy y en local del propio request. Solo
# hace falta si la app corre detrás de otro proxy o con un dominio propio.
# NEXT_PUBLIC_SITE_URL=https://horarios.tudominio.pe
