# Secretos de la Edge Function `send-email`.
#
# Copia este archivo a `supabase/functions/.env` (está en .gitignore), llénalo
# y súbelo al proyecto con:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# Si el CLI no ve el proyecto (sesión en otra cuenta), cárgalos a mano en
# Project Settings > Edge Functions > Secrets.
#
# SUPABASE_URL ya viene inyectada en las Edge Functions: no la pongas aquí.

# API key de Resend con permiso de envío: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Lo genera el dashboard al crear el hook, en Authentication > Hooks.
# Incluye el prefijo "v1,whsec_" tal cual te lo muestra.
SEND_EMAIL_HOOK_SECRET="v1,whsec_xxxxxxxxxxxxxxxxxxxx"

# Remitente. El dominio tiene que estar verificado en Resend.
AUTH_EMAIL_FROM="UTEC Horarios <no-reply@tu-dominio.dev>"
